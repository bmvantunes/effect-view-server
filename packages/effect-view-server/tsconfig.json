{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "@effect-view-server/source-adapter": ["../source-adapter/dist/index.d.ts"],
      "@effect-view-server/source-adapter/server": ["../source-adapter/dist/server.d.ts"],
      "effect-view-server/source-adapter": ["../source-adapter/dist/index.d.ts"],
      "effect-view-server/source-adapter/server": ["../source-adapter/dist/server.d.ts"]
    },
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.test-d.ts"]
}
