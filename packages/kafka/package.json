{
  "name": "@effect-view-server/kafka",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "bench:source-lanes": "vp run -t @effect-view-server/runtime-core#build && vp run -t @effect-view-server/source-adapter#build && sh -c 'output=${VIEW_SERVER_KAFKA_SOURCE_BENCH_OUTPUT_JSON:-.artifacts/source-lanes-64rows-64partitions.json}; mkdir -p .artifacts; VIEW_SERVER_KAFKA_SOURCE_BENCH_OUTPUT_JSON=\"$output\" vp test bench src/source-lanes.bench.ts --run --testTimeout 0 --outputJson \"$output\"'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@platformatic/kafka": "catalog:"
  },
  "devDependencies": {
    "@effect-view-server/config": "workspace:*",
    "@effect-view-server/runtime": "workspace:*",
    "@effect-view-server/runtime-core": "workspace:*",
    "@effect-view-server/source-adapter-conformance-host": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "catalog:",
    "effect": "4.0.0-rc.109",
    "effect-view-server": "0.0.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109",
    "effect-view-server": "0.0.6"
  }
}
