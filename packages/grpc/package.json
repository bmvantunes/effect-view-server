{
  "name": "@effect-view-server/grpc",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "vp run -t @effect-view-server/source-adapter#build && vp pack",
    "bench:adapter": "vp run -t @effect-view-server/config#build && vp run -t @effect-view-server/runtime-core#build && vp test bench src/grpc.bench.ts --run --testTimeout 0",
    "test": "vp run -t @effect-view-server/config#build && vp run -t @effect-view-server/protocol#build && vp run -t @effect-view-server/runtime-core#build && vp run -t @effect-view-server/server#build && vp run -t @effect-view-server/source-adapter-conformance-host#build && vp test run --coverage --typecheck"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@effect-view-server/source-adapter": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-view-server/client": "workspace:*",
    "@effect-view-server/config": "workspace:*",
    "@effect-view-server/protocol": "workspace:*",
    "@effect-view-server/runtime-core": "workspace:*",
    "@effect-view-server/server": "workspace:*",
    "@effect-view-server/source-adapter-conformance-host": "workspace:*",
    "@effect-view-server/source-adapter-testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
